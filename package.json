{
  "name": "nsd-box-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop:run": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win portable && npm run artifacts:clean",
    "desktop:build:clean": "npm run desktop:build",
    "desktop:portable": "npm run desktop:build",
    "artifacts:clean": "node -e \"const fs=require('fs'); for (const p of ['dist','release/win-unpacked','release/builder-effective-config.yaml','release/builder-debug.yml']) { try { fs.rmSync(p,{recursive:true,force:true}); } catch {} }\""
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "com.nsd.box.editor",
    "productName": "NSD Box Editor",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "package.json",
      "!src/**",
      "!**/*.map",
      "!tsconfig*.json",
      "!vite.config.ts",
      "!eslint.config.js",
      "!README.md"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ],
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}